# Non-secret defaults committed with the project, so every deploy works without
# extra setup. Override in `.env.local` (git-ignored) or your host's env settings.
VITE_SITE_URL=https://your-domain.com

# Contact form: Web3Forms access key. This key is PUBLIC by design (it can only
# deliver messages to the owner's inbox), so it is safe to commit and ship.
VITE_WEB3FORMS_ACCESS_KEY=a0d2f717-6eee-469c-8ee7-1294916c18cf
