# Copy to `.env.local` and fill in. Everything prefixed with VITE_ is bundled into
# the public JavaScript — NEVER put private API keys or secrets here.

# Your production URL (no trailing slash). Used for canonical/Open Graph tags.
VITE_SITE_URL=https://your-domain.com

# Contact form — pick ONE option. Leave both empty to fall back to opening the
# visitor's email app (mailto).

# Option 1 (simplest): Web3Forms — get a free access key at https://web3forms.com
# (enter your email, the key is emailed to you). This key is designed to be public.
VITE_WEB3FORMS_ACCESS_KEY=

# Option 2: any public form endpoint that accepts a JSON POST (e.g. Formspree:
# https://formspree.io/f/xxxxxxx). Takes priority over the Web3Forms default URL.
VITE_CONTACT_ENDPOINT=
