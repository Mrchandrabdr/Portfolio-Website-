# Copy to `.env.local` and fill in. Everything prefixed with VITE_ is bundled into
# the public JavaScript — NEVER put private API keys or secrets here.

# Your production URL (no trailing slash). Used for canonical/Open Graph tags.
VITE_SITE_URL=https://your-domain.com

# Contact form — a PUBLIC form endpoint that accepts a JSON POST.
# Formspree: create a form at https://formspree.io and paste its endpoint.
# Leave empty to fall back to opening the visitor's email app (mailto).
VITE_CONTACT_ENDPOINT=

# Optional: only if you use Web3Forms (endpoint https://api.web3forms.com/submit).
# Web3Forms access keys are designed to be public.
VITE_WEB3FORMS_ACCESS_KEY=
